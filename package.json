{
  "name": "sunrise-viewpoint-homestay",
  "version": "0.1.0",
  "description": "Marketing site and Payload CMS for Sunrise Viewpoint Homestay, Aahaldara",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "./scripts/with-db.sh cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "db:down": "docker compose stop",
    "db:up": "docker compose up -d --wait",
    "dev": "./scripts/with-db.sh cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && ./scripts/with-db.sh cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "./scripts/with-db.sh cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "./scripts/with-db.sh cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "./scripts/with-db.sh cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
