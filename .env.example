# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URI=postgres://payload:payload@localhost:5433/sunrise_viewpoint
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace_me_with_a_32_byte_hex_secret
# Guards /next/preview, which enables draft mode. Generate with: openssl rand -hex 32
PREVIEW_SECRET=replace_me_with_a_32_byte_hex_secret
# Origin the admin's Live Preview iframe points at, and the origin the browser posts preview data to.
# Must be the EXACT origin the admin is served at — scheme + host + port, no trailing slash, no path.
# Live Preview compares it verbatim against the message origin, and NEXT_PUBLIC_* is frozen at build
# time, so a mismatch makes preview silently do nothing (and needs a rebuild, not a restart, to fix).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
